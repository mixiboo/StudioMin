# Discord Bot Configuration
# Copy this file to .env and fill in your actual values

# Your Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Your Discord application (client) ID from https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_client_id_here

# Private web admin panel password (choose your own strong password)
ADMIN_PASSWORD=change_this_to_a_strong_password

# Port exposed by your hosting panel (Teredactyl/Pterodactyl)
WEB_PORT=3000

# Composio project API key from your Composio project settings
COMPOSIO_API_KEY=your_composio_project_api_key_here

# Stable Composio user ID used for this bot's connected accounts
COMPOSIO_USER_ID=studiomin-owner
